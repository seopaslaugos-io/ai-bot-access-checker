{
  "manifest_version": 3,
  "name": "AI Bot Access Checker",
  "short_name": "AI Bot Check",
  "version": "1.0.0",
  "description": "Check if GPTBot, ClaudeBot, PerplexityBot, Googlebot and 9 more AI crawlers can reach the page you are on.",
  "homepage_url": "https://seopaslaugos.io/en/tools/ai-bot-access-checker",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Check AI bot access for this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://tools.seopaslaugos.io/*"],
  "minimum_chrome_version": "102"
}
